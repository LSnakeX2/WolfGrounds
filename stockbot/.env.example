# ──────────────────────────────────────────────────────────────
# Wolf Grounds Alpha — credentials
#
# 1. Copy this file to ".env"  (cp .env.example .env)
# 2. Fill in your real values.
# 3. NEVER commit .env — it is gitignored for a reason.
# ──────────────────────────────────────────────────────────────

# Your Robinhood login email and password.
ROBINHOOD_USERNAME=you@example.com
ROBINHOOD_PASSWORD=your-password-here

# RECOMMENDED: app-based MFA secret (base32 string).
# In Robinhood: Settings -> Security -> Two-Factor Authentication ->
# "Authentication app" -> "Can't scan?" reveals the base32 secret.
# With this set, the bot logs in automatically with no SMS prompt.
# Leave blank to be prompted for an MFA code in the terminal instead.
ROBINHOOD_TOTP_SECRET=

# Local web server port for the dashboard.
PORT=5000

# ── Dashboard authentication ────────────────────────────────────────────────
# Leave DASHBOARD_PASSWORD blank for localhost-only use (no browser prompt).
# REQUIRED when HOST=0.0.0.0 — the server refuses to start without it.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Bind address. 127.0.0.1 = localhost only (default, safe).
# Set to 0.0.0.0 for cloud/VPS deployment — only with DASHBOARD_PASSWORD set.
HOST=127.0.0.1

# Safety switch for later steps. Stays "read_only" until you and I
# deliberately move to paper, then live. The backend refuses to place
# any order unless this is explicitly changed.
#   read_only -> no order endpoints active
#   paper     -> simulated fills only (Step 2)
#   live      -> REAL orders with REAL money (Step 3, not yet implemented)
TRADING_MODE=read_only

# Starting cash for the paper-trading sandbox (only used in paper mode).
PAPER_STARTING_CASH=10000

# ── Live-trading guardrails (only used when TRADING_MODE=live) ──────────────
# Hard cap on the dollar value of a single order. The server REJECTS any live
# order above this, regardless of what the dashboard sends. Start small.
MAX_ORDER_USD=500

# Optional cap on shares per order (0 = no share cap).
MAX_ORDER_SHARES=0

# Kill switch. Set to true to start with live trading disabled; toggle it live
# from the dashboard. When engaged, every live order is refused.
TRADING_KILLED=false

# ── Discord bridge (optional) ───────────────────────────────────────────────
# Push alerts: a Discord channel webhook URL. When set, the server posts a
# message when strategies run and when live orders are submitted. No bot needed.
DISCORD_WEBHOOK_URL=

# Interactive bot (discord_bridge.py). Token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=
# Restrict commands to one channel (right-click channel -> Copy ID). Strongly
# recommended — the bot can place real trades in live mode.
DISCORD_CHANNEL_ID=
# Comma-separated user ids allowed to trade / control (kill, enable, etc.).
# Leave blank to allow anyone in the channel (not recommended for live).
DISCORD_ALLOWED_USER_IDS=
# Command prefix (default "!") and the Flask API base URL.
DISCORD_PREFIX=!
STOCKBOT_API_URL=http://127.0.0.1:5000
